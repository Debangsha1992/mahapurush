{
  "name": "mahapurush",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run content:validate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:generate-people-library": "tsx scripts/generate-people-library.ts",
    "content:generate-person-facts": "tsx scripts/generate-person-facts.ts",
    "content:apply-curated-facts": "tsx scripts/apply-curated-facts.ts",
    "content:audit-person-facts": "tsx scripts/audit-person-facts.ts",
    "content:generate-images": "tsx scripts/generate-thinker-images.ts desktop",
    "content:generate-images:mobile": "tsx scripts/generate-thinker-images.ts mobile",
    "content:optimize-images": "tsx scripts/optimize-gallery-images.ts",
    "content:install-images": "tsx scripts/install-gallery-images.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@workos-inc/authkit-nextjs": "^4.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.6",
    "openai": "^6.41.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
