# WorkOS AuthKit (Staging). Copy to .env.local and fill in values from
# https://dashboard.workos.com — API Keys + Redirects.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# At least 32 characters. Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
# Must match the WorkOS redirect URI for this environment.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
